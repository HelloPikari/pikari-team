{
	"name": "pikari-inc/pikari-team",
	"description": "Team member CPT with digital business cards, PWA-enabled card pages, vCard QR codes, and customizable card templates",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Pikari Inc.",
			"email": "development@pikari.io"
		}
	],
	"homepage": "https://pikari.io",
	"autoload": {
		"psr-4": {
			"Pikari\\Team\\": "includes/"
		}
	},
	"require": {
		"php": ">=8.4",
		"chillerlan/php-qrcode": "^5.0",
		"yahnis-elsts/plugin-update-checker": "^5.6"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcsstandards/phpcsutils": "^1.0.12",
		"phpunit/phpunit": "^9.5",
		"php-stubs/wordpress-stubs": "^6.6",
		"brain/monkey": "^2.6",
		"mockery/mockery": "^1.6"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"lint:file": "phpcs --standard=phpcs.xml",
		"test": "phpunit",
		"test:coverage": "phpunit --coverage-html tests/coverage"
	}
}
